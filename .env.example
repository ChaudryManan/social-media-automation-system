ENVIRONMENT=development            # development | test | production
# Host machine development / Alembic / tests URL (port 15432 published by Docker Compose):
# Inside Docker containers, the host is 'postgres' on default port 5432: postgresql+psycopg://sma:sma@postgres:5432/sma
DATABASE_URL=postgresql+psycopg://sma:sma@127.0.0.1:15432/sma
TEST_DATABASE_URL=postgresql+psycopg://sma:sma@127.0.0.1:15432/sma_test
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
FERNET_KEY=generate-with-cryptography
CORS_ORIGINS=http://localhost:3000

LLM_PROVIDER=gemini                # gemini | fake
GEMINI_API_KEY=
LLM_MODEL_TEXT=                    # set explicitly; do not hard-code in code
LLM_MODEL_FAST=
IMAGE_PROVIDER=fake                # fake | <real provider>
VIDEO_PROVIDER=fake
TTS_PROVIDER=fake
SEARCH_PROVIDER=fake

STORAGE_BACKEND=local              # local | s3
STORAGE_PATH=./storage
S3_ENDPOINT= S3_BUCKET= S3_ACCESS_KEY= S3_SECRET_KEY=

PUBLISHER_MODE=mock                # mock | real
FACEBOOK_APP_ID= FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID= GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY= TIKTOK_CLIENT_SECRET=

# Initial Administrator Seeding (required when running `make seed`):
SEED_ADMIN_EMAIL=                      # required for `make seed`: e.g. admin@example.com
SEED_ADMIN_PASSWORD=                   # required for `make seed`: minimum 8 characters, never commit real passwords
